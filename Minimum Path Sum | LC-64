# Problem Link: https://leetcode.com/problems/minimum-path-sum/description/
#Solution: (Memoization)

class Solution {
public:

    int generate_min_sum_path(int i, int j, vector<vector<int>>& grid, vector<vector<int>>& dp){

        if(i == 0 && j == 0) return grid[i][j];
        if(i < 0 || j < 0) return 1e9;
        if(dp[i][j] != -1) return dp[i][j];

        int left = grid[i][j] + generate_min_sum_path(i, j - 1, grid, dp);
        int up = grid[i][j] + generate_min_sum_path(i - 1, j, grid, dp);
        return dp[i][j] = min(left, up);
    }

    int minPathSum(vector<vector<int>>& grid) {

        int m = grid.size();
        int n = grid[0].size();
        vector<vector<int>> dp(m, vector<int>(n, -1));

        return generate_min_sum_path(m - 1, n - 1, grid, dp);
    }
};
