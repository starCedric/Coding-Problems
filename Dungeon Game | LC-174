class Solution {
public:

    int savePrincess(int i, int j, vector<vector<int>>& dungeon, vector<vector<int>>& dp){

        int m = dungeon.size();
        int n = dungeon[0].size();
        
        if(i == m - 1 && j == n - 1)
        return (dungeon[i][j] <= 0) ? -dungeon[i][j] + 1 : 1;
        //return max(1, 1 - mat[i][j]);

        if(i >= m || j >= n) return 1e9;
        if(dp[i][j] != -1) return dp[i][j];

        int right = savePrincess(i, j + 1, dungeon, dp);
        int down = savePrincess(i + 1, j, dungeon, dp);

        int currHealth = dungeon[i][j];
        int futureHealthReq = min(right, down);
        int minHealthReq = futureHealthReq - currHealth;

        return dp[i][j] = (minHealthReq <= 0) ? 1 : minHealthReq;
    }

    int calculateMinimumHP(vector<vector<int>>& dungeon) {
        int i = 0, j = 0;
        vector<vector<int>> dp(dungeon.size(), vector<int>(dungeon[0].size(), -1));
        return savePrincess(i, j, dungeon, dp);
    }
};
